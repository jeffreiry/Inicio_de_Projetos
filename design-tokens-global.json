{
  "$description": "Design tokens globais — Identidade Jeferson Freiry. Formato W3C Design Tokens (DTCG). Espelha design-tokens-global.css token a token — qualquer mudança deve ser feita nos dois arquivos. Arquitetura de duas camadas: color.primitivo (DNA, nunca referenciado direto por componentes) → color.semantico.light/dark (papel, é isso que componentes usam). Cada produto do ecossistema copia este arquivo e sobrescreve apenas color.semantico com sua camada de produto — ver Painel_Saude/src/styles/tokens.json como exemplo aplicado.",

  "color": {
    "$type": "color",
    "primitivo": {
      "$description": "Paleta Brasileira + neutros quentes. Valores fixos — não mudam entre produtos nem entre modos.",
      "cha-mate":       { "$value": "#5c2d11", "$description": "terra escura" },
      "cha-mate-light": { "$value": "#7a3f1e", "$description": "variante clara" },
      "jambu":          { "$value": "#ed6707", "$description": "laranja vivo — só decorativo, não passa AA como texto" },
      "jambu-text":     { "$value": "#a8480c", "$description": "jambu como texto/borda sobre fundo claro (AA 4.5:1)" },
      "jambu-deep":     { "$value": "#a8480c", "$description": "jambu como fundo de botão com texto branco (AA 5.84:1)" },
      "sol-jalapao":    { "$value": "#f26b3a", "$description": "variante mais quente — gradientes/decorativos" },
      "fogueira":       { "$value": "#8c2f0d", "$description": "variante escura — contraste em dark mode" },
      "azul-pantanal":  { "$value": "#153c52", "$description": "azul profundo" },
      "figo":           { "$value": "#4d6046", "$description": "verde-musgo" },
      "page-bg":        { "$value": "#f5f2ee", "$description": "fundo de página — bege quente (base/Portfolio)" },
      "surface":        { "$value": "#ede8e2", "$description": "cards, inputs, widgets" },
      "surface-2":      { "$value": "#e2dbd3", "$description": "pills de tag, separadores" },
      "border":         { "$value": "#d9d2c8" },
      "white":          { "$value": "#ffffff" },
      "ink":            { "$value": "#0d0d0d", "$description": "quase-preto — texto principal" },
      "muted":          { "$value": "#7a6a60", "$description": "texto de apoio" },
      "faint":          { "$value": "#776559", "$description": "AA 4.97:1 sobre page-bg — eyebrows, metadados" }
    },
    "semantico": {
      "$description": "Aliases de papel → primitivo. Componentes só referenciam isto. O primitivo que cada papel aponta muda por modo (light/dark) e por camada de produto.",
      "light": {
        "text-heading":   { "$value": "{color.primitivo.cha-mate}" },
        "text-primary":   { "$value": "{color.primitivo.ink}" },
        "text-secondary": { "$value": "{color.primitivo.muted}" },
        "text-subtle":    { "$value": "{color.primitivo.faint}" },
        "bg-page":        { "$value": "{color.primitivo.page-bg}" },
        "bg-surface":     { "$value": "{color.primitivo.surface}" },
        "bg-surface-alt": { "$value": "{color.primitivo.surface-2}" },
        "border-default": { "$value": "{color.primitivo.border}" },
        "accent-deco":    { "$value": "{color.primitivo.jambu}", "$description": "decorativo — nav ativa, foco, CTAs pontuais. Nunca como texto." },
        "accent-text":    { "$value": "{color.primitivo.jambu-text}", "$description": "jambu como texto/borda (AA ≥4.5:1)" },
        "accent-btn":     { "$value": "{color.primitivo.jambu-deep}", "$description": "fundo de botão com texto branco (AA 5.84:1)" },
        "structural":     { "$value": "{color.primitivo.cha-mate}", "$description": "cor estruturante do produto — cada produto sobrescreve (Eixo→figo, Financeiro→azul-pantanal)" }
      },
      "dark": {
        "$description": "\"O dark que aquece\" — não é #000, é breu com brasa. Só os primitivos usados nestes papéis mudam de valor; os nomes dos papéis são os mesmos do light.",
        "text-heading":   { "$value": "#e8ddd5", "$description": "chá claro — mantém o papel de heading" },
        "text-primary":   { "$value": "#f0ebe4", "$description": "quase-branco creme" },
        "text-secondary": { "$value": "#a89080" },
        "text-subtle":    { "$value": "#998a7e", "$description": "AA 5.13:1 sobre surface-dark" },
        "bg-page":        { "$value": "#18120e", "$description": "breu quente" },
        "bg-surface":     { "$value": "#221a14" },
        "bg-surface-alt": { "$value": "#2c2118" },
        "border-default": { "$value": "#3d2e23" },
        "accent-deco":    { "$value": "{color.primitivo.jambu}" },
        "accent-text":    { "$value": "{color.primitivo.jambu}", "$description": "no escuro o tom puro já é legível como texto (5.34:1)" },
        "accent-btn":     { "$value": "{color.primitivo.jambu-deep}" },
        "structural":     { "$value": "#e8ddd5" }
      }
    }
  },

  "typography": {
    "font-family": {
      "display": { "$type": "fontFamily", "$value": ["DM Serif Display", "serif"], "$description": "voz editorial — manchetes, KPIs, títulos de seção" },
      "body":    { "$type": "fontFamily", "$value": ["Barlow", "sans-serif"], "$description": "voz funcional — corpo, labels, navegação, dados" }
    },
    "size": {
      "$type": "dimension",
      "$description": "display usa clamp(1.75rem,7vw,5rem) no CSS (responsivo) — 80px representa o teto (5rem) pra ferramentas sem suporte a clamp.",
      "display": { "$value": "80px" },
      "h1":      { "$value": "60px" },
      "h2":      { "$value": "36px" },
      "section": { "$value": "28px" },
      "card":    { "$value": "24px" },
      "h3":      { "$value": "20px" },
      "body-lg": { "$value": "18px" },
      "body":    { "$value": "17px" },
      "sm":      { "$value": "15px" },
      "xs":      { "$value": "13px" },
      "eyebrow": { "$value": "11px" },
      "caption": { "$value": "10px" }
    },
    "line-height": {
      "$type": "number",
      "tight":   { "$value": 0.92, "$description": "hero h1 display" },
      "heading": { "$value": 1.1, "$description": "headings de seção" },
      "normal":  { "$value": 1.625, "$description": "corpo compacto (dashboards)" },
      "relaxed": { "$value": 1.75, "$description": "corpo de leitura longa" }
    },
    "letter-spacing": {
      "$type": "dimension",
      "heading": { "$value": "-0.01em", "$description": "DM Serif headings — aperto sutil" },
      "eyebrow": { "$value": "0.12em", "$description": "labels uppercase" },
      "tag":     { "$value": "0.04em", "$description": "filter pills" },
      "caption": { "$value": "0.09em" }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm":    { "$value": "8px", "$description": "badges, code inline" },
    "input": { "$value": "12px", "$description": "inputs, imagens inline" },
    "card":  { "$value": "20px", "$description": "cards de conteúdo" },
    "hero":  { "$value": "24px", "$description": "hero cards, painéis" },
    "modal": { "$value": "24px" },
    "lg":    { "$value": "32px", "$description": "elementos de destaque" },
    "pill":  { "$value": "999px" },
    "tag":   { "$value": "999px" }
  },

  "space": {
    "$type": "dimension",
    "4":  { "$value": "4px" },
    "8":  { "$value": "8px" },
    "16": { "$value": "16px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "40": { "$value": "40px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" },
    "96": { "$value": "96px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms", "$description": "hover de links, filter pills" },
      "base": { "$value": "350ms", "$description": "transições de cards, header" },
      "slow": { "$value": "600ms", "$description": "scroll reveals, page transitions" }
    },
    "ease-out-expo": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
  },

  "layout": {
    "container-max": { "$type": "dimension", "$value": "1200px" }
  }
}
